# ==============================================================================
# USTA Tunja · Plataforma de Prenómina Docente (usta-web)
# ==============================================================================

# URL base de la API REST (en producción detrás de Nginx puede omitirse o usar /api)
# VITE_API_URL=http://localhost:4301

# ==============================================================================
# Migración a Directorio Activo (Microsoft Entra ID / MSAL SSO Institucional)
# ==============================================================================
# Nota: usta-web consulta automáticamente `GET /api/auth/config` al iniciar, por lo que
# basta con configurar AZURE_TENANT_ID y AZURE_CLIENT_ID en `usta-api/.env` sin necesidad
# de recompilar el frontend. Si prefieres inyectarlas también en tiempo de build de Vite:

# VITE_AUTH_MODE=hybrid
# VITE_INSTITUTIONAL_EMAIL_DOMAIN=santototunja.edu.co
# VITE_MSAL_CACHE_LOCATION=sessionStorage
# VITE_AZURE_TENANT_ID=<TU_AZURE_TENANT_ID>
# VITE_AZURE_CLIENT_ID=<TU_AZURE_CLIENT_ID>
# VITE_AZURE_API_SCOPE=api://<TU_AZURE_API_CLIENT_ID>/usuarios.read
# VITE_AZURE_REDIRECT_URI=https://prenomina.santototunja.edu.co/login
