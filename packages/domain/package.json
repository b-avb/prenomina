{
  "name": "@usta/domain",
  "version": "1.0.0",
  "private": true,
  "description": "Shared, framework-agnostic domain model, business rules and API contracts for the USTA Tunja faculty pre-payroll platform.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "~5.7.3"
  }
}
