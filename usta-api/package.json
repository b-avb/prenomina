{
  "name": "prenomina-back-usta-tunja",
  "version": "1.0.0",
  "description": "API REST en TypeScript y Persistencia Relacional MariaDB para el Aplicativo de Prenómina Docente USTA Seccional Tunja (ANEXOS 2, 3, 4, 5, 6 y 7)",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc",
    "build:prod": "rm -rf dist && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "tsc && node --watch dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsc && ALLOW_DESTRUCTIVE_STATE_RESET=true node dist/tests/production-e2e.test.js",
    "test:e2e": "tsc && ALLOW_DESTRUCTIVE_STATE_RESET=true node dist/tests/production-e2e.test.js",
    "db:migrate": "tsc && node dist/database/migrate.cli.js",
    "db:seed": "tsc && node dist/database/seed.cli.js",
    "db:import": "tsc && node dist/database/seed.cli.js --force",
    "db:reset": "tsc && node dist/database/migrate.cli.js && node dist/database/seed.cli.js --force"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "typescript": "~5.7.3"
  },
  "packageManager": "pnpm@10.24.0+sha512.01ff8ae71b4419903b65c60fb2dc9d34cf8bb6e06d03bde112ef38f7a34d6904c424ba66bea5cdcf12890230bf39f9580473140ed9c946fef328b6e5238a345a",
  "dependencies": {
    "@usta/domain": "workspace:*",
    "kysely": "^0.27.6",
    "mysql2": "^3.14.1"
  }
}
