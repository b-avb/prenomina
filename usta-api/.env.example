# ==============================================================================
# USTA Tunja · Plataforma de Prenómina Docente (usta-api)
# ==============================================================================

PORT=4301
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=*

# --- Base de Datos MariaDB 11 ---
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=usta_prenomina_tunja
DB_USER=usta_app
DB_PASSWORD=usta_app_local
DB_POOL_LIMIT=10

# --- Autenticación Local (Tokens de Sesión) ---
# En producción deploy.sh reemplaza automáticamente este valor con `openssl rand -hex 32`
AUTH_TOKEN_SECRET=replace-with-openssl-rand-hex-32

# ==============================================================================
# Migración a Directorio Activo (Microsoft Entra ID / MSAL SSO Institucional)
# ==============================================================================
# Modos soportados en AUTH_MODE:
#   - local     : Solo usuario (sin @dominio) + contraseña (temporal en primer ingreso).
#   - hybrid    : Permite tanto botón "Iniciar sesión con Microsoft" como usuario/contraseña local.
#   - microsoft : Exclusivamente SSO con Microsoft Entra ID (@santototunja.edu.co).
#
# Cuando la Universidad entregue las credenciales del App Registration, descomenta
# las variables AZURE_* en el archivo `.env` del servidor (no en el repositorio):

AUTH_MODE=local
INSTITUTIONAL_EMAIL_DOMAIN=santototunja.edu.co
MSAL_CACHE_LOCATION=sessionStorage

# AZURE_TENANT_ID=<TU_AZURE_TENANT_ID>
# AZURE_CLIENT_ID=<TU_AZURE_CLIENT_ID>
# AZURE_API_SCOPE=api://<TU_AZURE_API_CLIENT_ID>/usuarios.read
