# Runtime configuration template for `usta-api`.
# Copy to `usta-api/.env` for local development. In production, `deploy.sh`
# provisions `/opt/usta-plataforma/usta-api/.env` (`chmod 600`) automatically.

PORT=4301
HOST=127.0.0.1
NODE_ENV=development
CORS_ORIGIN=http://localhost:4300,http://127.0.0.1:4300,http://localhost:4301
TRUST_PROXY=false
UPLOADS_DIR=./uploads

# MariaDB / MySQL connection pool.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=usta_prenomina_tunja
DB_USER=usta_app
DB_PASSWORD=usta_app_local
DB_POOL_LIMIT=10

# HMAC-SHA256 signing key for session JWTs (>= 32 random chars required in production).
# `deploy.sh` generates this value via `openssl rand -hex 32` when provisioning a host.
AUTH_TOKEN_SECRET=replace-with-openssl-rand-hex-32

# Authentication mode:
#   local     — local username/password authentication only
#   hybrid    — Microsoft Entra ID SSO alongside local credentials
#   microsoft — Microsoft Entra ID SSO exclusively
AUTH_MODE=local
INSTITUTIONAL_EMAIL_DOMAIN=santototunja.edu.co
MSAL_CACHE_LOCATION=sessionStorage

# Uncomment on the server `.env` (never in version control) once Entra ID App Registration values are issued:
# AZURE_TENANT_ID=<AZURE_TENANT_ID>
# AZURE_CLIENT_ID=<AZURE_CLIENT_ID>
# AZURE_API_SCOPE=api://<AZURE_API_CLIENT_ID>/usuarios.read
